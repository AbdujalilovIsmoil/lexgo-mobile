{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "ios": {
        "autoIncrement": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "<Apple ID email of the App Store Connect account>",
        "ascAppId": "<App Store Connect app id (numbers)>",
        "appleTeamId": "<Team ID>"
      }
    }
  }
}
