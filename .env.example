# Backend origin (no trailing slash). Same backend the Next.js site proxies to.
EXPO_PUBLIC_API_BASE_URL=https://lexgo.api.cognilabs.org
# Payment provider for order invoices: payme | click | atmos (payme/click return 503 until connected)
EXPO_PUBLIC_PAYMENT_PROVIDER=payme

# Dev only, iOS simulator: copy the Mac clipboard into the simulator when its own pasteboard sync is stuck (1 = on). Off by default:
# the Simulator copies each such write back to the Mac and that emptied the Mac clipboard (Cmd+C on the Mac was lost within a second)
EXPO_PUBLIC_SYNC_HOST_CLIPBOARD=0
