{
  "expo": {
    "name": "LexGo",
    "slug": "lexgo",
    "version": "1.1.0",
    "scheme": "lexgo",
    "orientation": "portrait",
    "icon": "./logos/app-store/lexgo-app-store-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "org.cognilabs.lexgo",
      "backgroundColor": "#03102B",
      "associatedDomains": [
        "applinks:lexgo.uz"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "org.cognilabs.lexgo",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./logos/android/adaptive-foreground.png",
        "backgroundImage": "./logos/android/adaptive-background.png",
        "monochromeImage": "./logos/android/adaptive-monochrome.png",
        "backgroundColor": "#0A4B40"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lexgo.uz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03102B",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ],
      "./plugins/withDarkWindow",
      "./plugins/withUIScene",
      "expo-sharing",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "LexGo video uchrashuvlar uchun kameradan foydalanadi.",
          "microphonePermission": "LexGo qo'ng'iroq va uchrashuvlar uchun mikrofondan foydalanadi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LexGo suhbatga rasm yuborish va hujjat skanerlash uchun galereyaga kiradi.",
          "cameraPermission": "LexGo suhbatga rasm yuborish va hujjatlarni skanerlash uchun kameradan foydalanadi."
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "LexGo ovozli xabar yozish uchun mikrofondan foydalanadi."
        }
      ],
      "expo-web-browser",
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LexGo ilovani Face ID bilan tez va xavfsiz ochish uchun ruxsat so'raydi."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LexGo fayllarni galereyaga saqlash uchun ruxsat so'raydi.",
          "savePhotosPermission": "LexGo faylni galereyaga saqlaydi.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./logos/android/notification-icon.png",
          "color": "#14866E",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LexGo yaqin atrofdagi mijozlarga sizni taxminiy masofa bilan ko'rsatish uchun, ilova ochiq turganda joylashuvingizdan foydalanadi.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "LexGo hujjatlarni skanerlash uchun kameradan foydalanadi."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#03102B",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "3c3729af-185c-4be7-8c62-298aff835b84"
      }
    },
    "owner": "ismoilabdujalilov",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c3729af-185c-4be7-8c62-298aff835b84",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
