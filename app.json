{
  "expo": {
    "name": "LexGo",
    "slug": "lexgo",
    "version": "1.1.0",
    "scheme": "lexgo",
    "orientation": "portrait",
    "icon": "./logos/app-store/lexgo-app-store-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "org.cognilabs.lexgo",
      "buildNumber": "20261103",
      "backgroundColor": "#03102B",
      "associatedDomains": [
        "applinks:lexgo.uz"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "org.cognilabs.lexgo.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./logos/android/adaptive-foreground.png",
        "monochromeImage": "./logos/android/adaptive-monochrome.png",
        "backgroundColor": "#0B1F45"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lexgo.uz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03102B",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ],
      "./plugins/withDarkWindow",
      "./plugins/withUIScene",
      "expo-sharing",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "LexGo video uchrashuvlar uchun kameradan foydalanadi.",
          "microphonePermission": "LexGo qo'ng'iroq va uchrashuvlar uchun mikrofondan foydalanadi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LexGo suhbatga rasm yuborish va hujjat skanerlash uchun galereyaga kiradi.",
          "cameraPermission": "LexGo suhbatga rasm yuborish va hujjatlarni skanerlash uchun kameradan foydalanadi."
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "LexGo ovozli xabar yozish uchun mikrofondan foydalanadi."
        }
      ],
      "expo-web-browser",
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LexGo ilovani Face ID bilan tez va xavfsiz ochish uchun ruxsat so'raydi."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LexGo fayllarni galereyaga saqlash uchun ruxsat so'raydi.",
          "savePhotosPermission": "LexGo faylni galereyaga saqlaydi.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# R8 keep rules (Play wants the code shrunk; these are the places R8 cannot see through)\n# LexGo's own Expo modules (net-path, pdf-pages, screen-guard, text-ocr)\n-keep class org.cognilabs.** { *; }\n# Tesseract OCR is called through JNI\n-keep class cz.adaptech.tesseract4android.** { *; }\n-keep class com.googlecode.tesseract.android.** { *; }\n# LiveKit / WebRTC: JNI + reflection\n-keep class org.webrtc.** { *; }\n-keep class livekit.org.** { *; }\n-keep class org.jni_zero.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class com.livekit.reactnative.** { *; }\n# Classes that only native (.so) code looks up by name: R8 would otherwise drop or rename them\n-keep class com.facebook.animated.** { *; }\n-keep class com.facebook.react.runtime.cxxreactpackage.** { *; }\n# Expo background tasks: the headless app loader is named only in AndroidManifest meta-data, which R8 does not treat as a reference\n-keep class expo.modules.adapters.react.apploader.** { *; }\n# Skia, Reanimated/Worklets\n-keep class com.shopify.reactnative.skia.** { *; }\n-keep class com.swmansion.** { *; }\n-dontwarn org.webrtc.**\n-dontwarn livekit.org.**\n-dontwarn com.facebook.animated.**"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./logos/android/notification-icon.png",
          "color": "#3B82F6",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LexGo yaqin atrofdagi mijozlarga sizni taxminiy masofa bilan ko'rsatish uchun, ilova ochiq turganda joylashuvingizdan foydalanadi.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "LexGo hujjatlarni skanerlash uchun kameradan foydalanadi."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#03102B",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "4919a25b-38c2-44ad-9ac4-eef07dcd72a2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4919a25b-38c2-44ad-9ac4-eef07dcd72a2",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "cognilabs-dev"
  }
}
